# Copy to .env (or just export these in your shell). Never commit real secrets.

# AWS auth — configure in your terminal first (aws configure / aws sso login),
# then point at the profile. The doctor uses standard boto3 credential resolution.
AWS_PROFILE=default
AWS_REGION=us-east-1

# Optional: pin exact Nova ids per tier (otherwise the us.* inference profiles are used).
# NOVA_REASONING_MODEL_ID=us.amazon.nova-pro-v1:0
# NOVA_FAST_MODEL_ID=us.amazon.nova-lite-v1:0
